      <body>
        <field key="callId" labelZh="呼叫标识" display="HEX" bytes="2" />
        <field key="resourceId" labelZh="接收资源标识" display="HEX" bytes="2" />
        <field key="assignedRxKbps" labelZh="分配接收带宽" display="HEX" bytes="2" />
        <field key="rxFreqKHz" labelZh="接收中心频率" display="HEX" bytes="4" />
        <field key="slotIndex" labelZh="时隙号" display="HEX" bytes="2" />
        <field key="resourceVersion" labelZh="资源配置版本" display="HEX" bytes="2" />
        <field key="applyFlag" labelZh="生效标志" display="HEX" bytes="1">
          <enum hex="00" labelZh="预配置" />
          <enum hex="01" labelZh="应用" />
