        <field key="reserved" labelZh="保留字段" display="HEX" bytes="1" fixed="00" />
      </body>
      <trailer ref="crcCcittFalse2" />
    </message>
    <message code="0x62" id="PAGING_REQ" nameZh="寻呼请求" responseCodes="0x63">
      <header ref="muspHeader23" />
      <headerExtension ref="authTLV" when="bit(header.flags,0)==1" />
      <body>
        <field key="callerAddr" labelZh="主叫地址" display="HEX" bytes="3" />
        <field key="callId" labelZh="呼叫标识" display="HEX" bytes="2" />
        <field key="mediaType" labelZh="媒体类型" display="HEX" bytes="1" />
        <field key="suggestTxKbps" labelZh="建议发送带宽" display="HEX" bytes="2" />
        <field key="suggestRxKbps" labelZh="建议接收带宽" display="HEX" bytes="2" />
        <field key="responseTimeoutSec" labelZh="应答期限" display="HEX" bytes="2" />
        <field key="reserved" labelZh="保留字段" display="HEX" bytes="1" fixed="00" />
      </body>
      <trailer ref="crcCcittFalse2" />
    </message>
    <message code="0x63" id="PAGING_RSP" nameZh="寻呼响应">
      <header ref="muspHeader23" />
      <headerExtension ref="authTLV" when="bit(header.flags,0)==1" />
      <body>
        <field key="callId" labelZh="呼叫标识" display="HEX" bytes="2" />
        <field key="pagingResult" labelZh="寻呼结果" display="HEX" bytes="1">
          <enum hex="00" labelZh="接受" />
          <enum hex="01" labelZh="拒绝" />
          <enum hex="02" labelZh="忙" />
          <enum hex="03" labelZh="超时等价业务结果" />
        </field>
        <field key="acceptedMedia" labelZh="接受的媒体能力" display="HEX" bytes="1" />
        <field key="reserved" labelZh="保留字段" display="HEX" bytes="1" fixed="00" />
      </body>
      <trailer ref="crcCcittFalse2" />
    </message>
    <message code="0x64" id="CALL_NOTIFY" nameZh="通话许可通知">
      <header ref="muspHeader23" />
      <headerExtension ref="authTLV" when="bit(header.flags,0)==1" />
