        <field key="peerAddr" labelZh="对端地址" display="HEX" bytes="3" />
      </body>
      <trailer ref="crcCcittFalse2" />
    </message>
    <message code="0x65" id="VOICE_CALL_REQ" nameZh="单端语音申请" responseCodes="0x66">
