{
  "schemaVersion": 1,
  "id": "musp-device-register",
  "nameZh": "无人机开机注册-认证-完成",
  "version": "0.1.0",
  "protocol": { "id": "musp-demo", "version": "0.8.0" },
  "participants": ["deviceA", "controlSystem"],
  "config": { "maxDurationMs": 60000, "maxConcurrentInstances": 200 },
  "nodes": [
    { "id": "start", "type": "START", "data": { "label": "开始" } },
    { "id": "send-register", "type": "SEND_AND_WAIT", "data": { "label": "发送开机注册", "sender": "deviceA", "receiver": "controlSystem", "requestMsgCode": "0x01", "expectCodes": ["0x02"], "correlateBy": ["protocolVersion", "endpoint", "msgCode", "srcAddr", "dstAddr", "transactionId"], "timeoutMs": 3000, "maxRetries": 3, "retryIntervalMs": 1000 } },
    { "id": "check-license", "type": "CONDITION", "data": { "expression": "response.resultCode==0", "label": "注册许可?" } },
    { "id": "save-session", "type": "ASSIGN", "data": { "set": [{"path":"session.id","from":"response.header.sessionId"},{"path":"session.authMode","from":"response.body.authMode"}] } },
    { "id": "check-auth", "type": "CONDITION", "data": { "expression": "session.authMode==1", "label": "是否需要认证" } },
    { "id": "wait-auth", "type": "WAIT_EVENT", "data": { "event": "session.authReady", "timeoutMs": 3000 } },
    { "id": "send-confirm", "type": "SEND_AND_WAIT", "data": { "requestMsgCode": "0x03", "expectCodes": ["0x04"], "sender":"deviceA", "receiver":"controlSystem", "timeoutMs":3000, "maxRetries":3, "correlateBy":["protocolVersion","endpoint","msgCode","srcAddr","dstAddr","transactionId","sessionId"] } },
    { "id": "check-complete", "type": "CONDITION", "data": { "expression": "response.resultCode==0" } },
    { "id": "set-online", "type": "UPDATE_DEVICE", "data": { "device":"deviceA", "state":"ONLINE" } },
    { "id": "failed", "type": "END", "data": { "result":"FAILED" } },
    { "id": "end", "type": "END", "data": { "result":"SUCCESS" } }
  ],
  "edges": [
    { "source":"start","target":"send-register" },
    { "source":"send-register","target":"check-license","label":"matched" },
    { "source":"send-register","target":"failed","label":"timeout" },
    { "source":"check-license","target":"save-session","sourceHandle":"true" },
    { "source":"check-license","target":"failed","sourceHandle":"false" },
    { "source":"save-session","target":"check-auth" },
    { "source":"check-auth","target":"wait-auth","sourceHandle":"true" },
    { "source":"check-auth","target":"send-confirm","sourceHandle":"false" },
    { "source":"wait-auth","target":"send-confirm","label":"event" },
    { "source":"wait-auth","target":"failed","label":"timeout" },
    { "source":"send-confirm","target":"check-complete","label":"matched" },
    { "source":"send-confirm","target":"failed","label":"timeout" },
    { "source":"check-complete","target":"set-online","sourceHandle":"true" },
    { "source":"check-complete","target":"failed","sourceHandle":"false" },
    { "source":"set-online","target":"end" }
  ],
  "asynchronousTriggers": [
    {"msgCode":"0x11","handler":"receive-auth-issued","matchBy":["device","sessionId","sourceSystem"],"effect":"storeTokenAndEmitAuthReady","replyMsgCode":"0x12"}
  ]
}
