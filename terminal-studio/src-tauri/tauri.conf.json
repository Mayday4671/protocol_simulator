{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simulated Terminal",
  "version": "0.1.0",
  "identifier": "com.simterm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "多协议模拟系统",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=Autofill,AutofillServerCommunication,msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["WebView2Loader.dll"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
