{
  "id": "register-no-auth",
  "nameZh": "注册—无需认证模式",
  "version": "1.0.0",
  "schemaVersion": 1,
  "description": "需要先创建本地设备。只接受authMode=0；许可和完成响应均经唯一匹配。authMode=1应使用单独认证流程，不能跳过。",
  "protocol": {
    "id": "MUSP_PROTOCOL_VERSION",
    "version": "0.8"
  },
  "config": {
    "maxDurationMs": 120000,
    "maxSteps": 20000,
    "maxConcurrentInstances": 200
  },
  "defaultVariables": {
    "deviceAddress": "00 00 3B",
    "controllerAddress": "00 00 01",
    "deviceNumericId": 59
  },
  "inputs": [
    "systemId",
    "endpointId",
    "remote"
  ],
  "nodes": [
    {
      "id": "start",
      "type": "START",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {}
    },
    {
      "id": "register",
      "type": "SEND_AND_WAIT",
      "position": {
        "x": 280,
        "y": 0
      },
      "data": {
        "label": "register",
        "code": 1,
        "values": {
          "srcAddr": "${deviceAddress}",
          "dstAddr": "${controllerAddress}",
          "sessionId": 0,
          "body": {
            "deviceType": 1,
            "deviceNumericId": "${deviceNumericId}",
            "bootReason": 1,
            "capabilityFlags": 3,
            "configVersion": 1
          }
        },
        "expectedCodes": [
          2
        ],
        "timeoutMs": 2000,
        "retries": 2,
        "retryIntervalMs": 200
      }
    },
    {
      "id": "check-license",
      "type": "CONDITION",
      "position": {
        "x": 560,
        "y": 0
      },
      "data": {
        "expression": "response.body.resultCode == 0 && response.body.authMode == 0"
      }
    },
    {
      "id": "save-session",
      "type": "ASSIGN",
      "position": {
        "x": 840,
        "y": 0
      },
      "data": {
        "set": [
          {
            "path": "sessionId",
            "from": "response.header.sessionId"
          }
        ]
      }
    },
    {
      "id": "confirm",
      "type": "SEND_AND_WAIT",
      "position": {
        "x": 1120,
        "y": 0
      },
      "data": {
        "label": "confirm",
        "code": 3,
        "values": {
          "srcAddr": "${deviceAddress}",
          "dstAddr": "${controllerAddress}",
          "sessionId": "${sessionId}",
          "body": {
            "deviceNumericId": "${deviceNumericId}",
            "confirmResult": 0
          }
        },
        "expectedCodes": [
          4
        ],
        "timeoutMs": 2000,
        "retries": 2,
        "retryIntervalMs": 200
      }
    },
    {
      "id": "check-complete",
      "type": "CONDITION",
      "position": {
        "x": 0,
        "y": 150
      },
      "data": {
        "expression": "response.body.resultCode == 0"
      }
    },
    {
      "id": "end",
      "type": "END",
      "position": {
        "x": 280,
        "y": 150
      },
      "data": {}
    },
    {
      "id": "error",
      "type": "ERROR",
      "position": {
        "x": 560,
        "y": 150
      },
      "data": {
        "message": "注册未完成，或对端要求独立认证"
      }
    }
  ],
  "edges": [
    {
      "source": "register",
      "target": "error",
      "label": "timeout"
    },
    {
      "source": "check-license",
      "target": "save-session",
      "label": "true"
    },
    {
      "source": "check-license",
      "target": "error",
      "label": "false"
    },
    {
      "source": "confirm",
      "target": "error",
      "label": "timeout"
    },
    {
      "source": "check-complete",
      "target": "end",
      "label": "true"
    },
    {
      "source": "check-complete",
      "target": "error",
      "label": "false"
    },
    {
      "source": "start",
      "target": "register"
    },
    {
      "source": "register",
      "target": "check-license",
      "label": "matched"
    },
    {
      "source": "save-session",
      "target": "confirm"
    },
    {
      "source": "confirm",
      "target": "check-complete",
      "label": "matched"
    }
  ]
}
