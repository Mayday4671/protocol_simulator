{
  "id": "heartbeat",
  "nameZh": "已注册设备的三轮心跳",
  "version": "1.0.0",
  "schemaVersion": 1,
  "description": "有限循环演示：每轮真实发送0x31并等待0x32；失败走错误出口。旧会话心跳不会将离线设备自动恢复在线。",
  "protocol": {
    "id": "MUSP_PROTOCOL_VERSION",
    "version": "0.8"
  },
  "config": {
    "maxDurationMs": 120000,
    "maxSteps": 20000,
    "maxConcurrentInstances": 200
  },
  "defaultVariables": {
    "deviceAddress": "00 00 3B",
    "controllerAddress": "00 00 01",
    "sessionId": 1
  },
  "inputs": [
    "systemId",
    "endpointId",
    "remote",
    "sessionId"
  ],
  "nodes": [
    {
      "id": "start",
      "type": "START",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {}
    },
    {
      "id": "repeat",
      "type": "LOOP",
      "position": {
        "x": 280,
        "y": 0
      },
      "data": {
        "maxIterations": 3,
        "count": 3
      }
    },
    {
      "id": "heartbeat",
      "type": "SEND_AND_WAIT",
      "position": {
        "x": 560,
        "y": 0
      },
      "data": {
        "label": "heartbeat",
        "code": 49,
        "values": {
          "srcAddr": "${deviceAddress}",
          "dstAddr": "${controllerAddress}",
          "sessionId": "${sessionId}",
          "body": {
            "uptimeSeconds": 0,
            "statusFlags": 1
          }
        },
        "expectedCodes": [
          50
        ],
        "timeoutMs": 2000,
        "retries": 2,
        "retryIntervalMs": 200
      }
    },
    {
      "id": "check",
      "type": "CONDITION",
      "position": {
        "x": 840,
        "y": 0
      },
      "data": {
        "expression": "response.body.resultCode == 0"
      }
    },
    {
      "id": "interval",
      "type": "DELAY",
      "position": {
        "x": 1120,
        "y": 0
      },
      "data": {
        "durationMs": 1000
      }
    },
    {
      "id": "end",
      "type": "END",
      "position": {
        "x": 0,
        "y": 150
      },
      "data": {}
    },
    {
      "id": "error",
      "type": "ERROR",
      "position": {
        "x": 280,
        "y": 150
      },
      "data": {
        "message": "心跳应答未确认"
      }
    }
  ],
  "edges": [
    {
      "source": "heartbeat",
      "target": "error",
      "label": "timeout"
    },
    {
      "source": "check",
      "target": "interval",
      "label": "true"
    },
    {
      "source": "check",
      "target": "error",
      "label": "false"
    },
    {
      "source": "start",
      "target": "repeat"
    },
    {
      "source": "repeat",
      "target": "heartbeat",
      "label": "body"
    },
    {
      "source": "repeat",
      "target": "end",
      "label": "done"
    },
    {
      "source": "heartbeat",
      "target": "check",
      "label": "matched"
    },
    {
      "source": "interval",
      "target": "repeat"
    }
  ]
}
