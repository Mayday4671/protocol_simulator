{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MUSP Studio",
  "version": "0.1.1",
  "identifier": "dev.musp.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"title":"MUSP Studio","width":1586,"height":992,"minWidth":1100,"minHeight":700,"decorations":false,"shadow":true}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; font-src 'self' data:"}
  },
  "bundle": {
    "active":true,
    "targets":["nsis"],
    "icon":["icons/icon.ico"],
    "resources":["../protocols/*","../workflows/*"],
    "windows": {
      "webviewInstallMode":{"type":"offlineInstaller"},
      "nsis":{"installMode":"currentUser","languages":["SimpChinese","English"],"displayLanguageSelector":true}
    }
  }
}
